#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then checker=python3
elif python -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then checker=python
else echo 'Public-source check requires Python 3; push blocked.' >&2; exit 1
fi
"$checker" scripts/check-public.py --staged
exec "$checker" scripts/check-public.py --history
